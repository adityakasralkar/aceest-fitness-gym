FLASK_ENV=development
APP_VERSION=local
DEPLOYMENT_VARIANT=local
DATABASE_URL=postgresql url
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# AIDevOps monitoring (OpenTelemetry). Leave AIDEVOPS_API_KEY blank to disable.
# Get the key by registering this project in AIDevOps (shown once).
AIDEVOPS_URL=http://localhost:8080
AIDEVOPS_API_KEY=
